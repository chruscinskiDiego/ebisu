# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=ebisu

# Optional: public cryptocurrency market-data endpoint.
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision/api/v3/

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=ebisu
POSTGRES_SSL=false

TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS_RUN=false
